# Cliente (frontend) - Supabase
# Usar estas variables en el frontend / dev para inicializar el cliente Supabase.
# NO pongas credenciales de base de datos privadas aquí.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Base de datos (solo para uso en servidor/backends). No exponer en el frontend.
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Ejemplo: para desarrollo local puedes copiar este archivo a `.env` y rellenar valores.