{
  "name": "sistema-reservas",
  "version": "1.0.0",
  "description": "Sistema de Reservas de Espacios o Recursos con Angular y Supabase",
  "private": true,
  "scripts": {
    "ng": "ng",
    "generate-env": "node scripts/generate-env-config.js",
    "start": "npm run generate-env && ng serve --open",
    "dev": "npm run generate-env && ng serve",
    "build": "npm run generate-env && ng build",
    "build:prod": "npm run generate-env && ng build --configuration production",
    "watch": "npm run generate-env && ng build --watch --configuration development",
    "test": "npm run generate-env && ng test",
    "lint": "ng lint",
    "postinstall": "npm run generate-env"
  },
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/node": "^20.0.0",
    "typescript": "~5.5.0"
  }
}